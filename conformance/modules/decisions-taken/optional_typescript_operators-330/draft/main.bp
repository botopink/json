//// Decision 330 — `?T` is read with TypeScript's operators and has no methods; `result` goes; a type declared in a type is its associated type.

import {io.terminal} from "std";
import {Json, decode} from "json";

pub type Settings {
    Loaded(doc: Json),
    Missing,

    pub type Origin(path: string)
}

fn read(origin: Settings.Origin, text: string) -> Settings {
    val parsed = decode(text);
    if (parsed.isError()) return Settings.Missing;
    return Settings.Loaded(doc: parsed.unwrapOr(Json.Null));
}

pub fn main() -> void {
    val origin = Settings.Origin(path: "app.json");
    val settings = read(origin, "{\"name\": \"botopink\", \"tags\": [\"lang\", \"wasm\"]}");
    val doc = case settings {
        Loaded(doc: d) -> d;
        Missing -> Json.Null;
    };

    val name = doc.field("name")?.str() ?? "anonymous";
    val version = doc.field("version")?.str() ?? "0.0.0";
    val tags = doc.field("tags")?.items() ?? [];
    val first = tags.at(0)?.str() ?? "none";
    val named = (doc.field("name") ?? Json.Null).isObject() || doc.isObject();
    val tagged = doc.field("tags")!;

    terminal.print(origin.path, name, version, first, named, tagged.kindName());
}
