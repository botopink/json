//// Decision 778 — json's helpers (396 (1)): `unquote(s: string) -> Result<string, JsonError>` reads a JSON string literal back to its text, the inverse of `quote`; `array(items: string[]) -> string` and `object(members: #(string, string)[]) -> string` join texts that are already JSON values into one JSON text, no escaping of the parts.

import {io.terminal} from "std";
import {Json, decode, quote, unquote, array, object} from "json";

pub fn main() -> void {
    val literal = quote("say \"hi\"");
    terminal.print(literal);
    terminal.print(try unquote(literal) catch "refused");
    terminal.print(try unquote("42") catch "refused");
    terminal.print(try unquote("Ada") catch "refused");

    val person = object([
        #("name", quote("Ada")),
        #("tags", array([quote("math"), quote("code")])),
        #("born", "1815"),
        #("active", "true"),
    ]);
    terminal.print(person);

    val unchecked = object([#("name", "Ada")]);
    val good = try decode(person) catch Json.Null;
    val bad = try decode(unchecked) catch Json.Null;
    terminal.print(good.isObject(), bad.isObject());
}
