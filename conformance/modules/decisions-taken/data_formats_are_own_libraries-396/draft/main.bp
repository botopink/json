//// Decision 396 — Markdown, YAML and JSON are three libraries of their own — `markdown`, `yaml`, `json` (`botopink/{markdown,yaml,json}` at `repository/{markdown,yaml,json}`, 326's rule) — and std knows nothing of JSON.

import {io.terminal} from "std";
import {Json, decode, encode, quote, unquote, array, object} from "json";

pub fn main() -> void {
    val text = object([
        #("name", quote("botopink")),
        #("formats", array([quote("json"), quote("yaml"), quote("markdown")])),
    ]);
    val doc = try decode(text) catch Json.Null;
    val formats = (doc.field("formats")?.items() ?? []).map({ f -> f.str() });
    val name = try unquote(quote(doc.field("name")?.str() ?? "")) catch "";

    terminal.print(doc.isObject(), name, formats.join(" "), encode(doc));
}
